{
	"name": "autopost",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/wrap-worker.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run build && wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply mengepost --local",
		"types": "wrangler types && sed -i.bak '/mainModule: typeof import/d' worker-configuration.d.ts && rm worker-configuration.d.ts.bak"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261113.1": true
	}
}
